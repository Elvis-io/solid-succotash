<Window
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Curtain Wall Front Elevation Sheets"
Width="650"
Height="930"
MinWidth="650"
MinHeight="760"
WindowStartupLocation="CenterScreen"
ResizeMode="CanResize"
ShowInTaskbar="False"
Background="#F3F4F6"
FontFamily="Segoe UI"
FontSize="13">
<Window.Resources>
<Style TargetType="TextBlock"><Setter Property="Foreground" Value="#1F2937" /></Style>
<Style TargetType="Label"><Setter Property="Foreground" Value="#374151" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Padding" Value="0,0,0,5" /></Style>
<Style TargetType="TextBox"><Setter Property="Height" Value="31" /><Setter Property="Padding" Value="8,4" /><Setter Property="BorderBrush" Value="#CBD5E1" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="White" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
<Style TargetType="ComboBox"><Setter Property="Height" Value="31" /><Setter Property="Padding" Value="6,2" /><Setter Property="BorderBrush" Value="#CBD5E1" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="White" /><Setter Property="IsTextSearchEnabled" Value="True" /></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="#1F2937" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
<Style x:Key="SectionHeader" TargetType="TextBlock"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="#0F172A" /><Setter Property="Margin" Value="0,0,0,10" /></Style>
<Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="Height" Value="34" /><Setter Property="Padding" Value="15,4" /><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#1F2937" /><Setter Property="BorderBrush" Value="#CBD5E1" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Cursor" Value="Hand" /></Style>
<Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="Height" Value="38" /><Setter Property="MinWidth" Value="205" /><Setter Property="Padding" Value="18,5" /><Setter Property="Background" Value="#2563EB" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderBrush" Value="#1D4ED8" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Cursor" Value="Hand" /></Style>
</Window.Resources>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<Border Grid.Row="0" Background="#0F172A" Padding="24,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="Curtain Wall Front Elevation Sheets" Foreground="White" FontSize="22" FontWeight="Bold" /><TextBlock Text="Create one tightly cropped, isolated front elevation per curtain wall and distribute the views across one or more sheets." Foreground="#CBD5E1" Margin="0,6,20,0" TextWrapping="Wrap" /></StackPanel><Border Grid.Column="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="12,8" VerticalAlignment="Center"><TextBlock x:Name="wall_count_text" Foreground="#E2E8F0" FontWeight="SemiBold" TextAlignment="Center" Text="Curtain walls found" /></Border></Grid></Border>
<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="22,18,22,12">
<Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Style="{StaticResource SectionHeader}" Text="View and sheet setup" /><Label Content="Title block type" /><ComboBox x:Name="title_block_combo" Margin="0,0,0,5" SelectionChanged="title_block_changed" /><TextBlock x:Name="sheet_size_text" Margin="1,0,0,12" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Text="Detected sheet size" /><Label Content="Section view type" /><ComboBox x:Name="section_type_combo" Margin="0,0,0,12" /><Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="5" Padding="11,9" Margin="0,0,0,12"><StackPanel><TextBlock Text="Front elevation only" FontWeight="Bold" Foreground="#166534" /><TextBlock x:Name="front_only_text" Margin="0,3,0,0" Foreground="#166534" FontSize="11" TextWrapping="Wrap" Text="One front elevation is created for each curtain-wall instance." /></StackPanel></Border><CheckBox x:Name="name_by_type_check" Margin="0,0,0,14"><TextBlock Text="Name each view using its curtain wall type" TextWrapping="Wrap" /></CheckBox><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="0.36*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="0.64*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><Label Content="First sheet number" /><TextBox x:Name="sheet_number_text" /></StackPanel><StackPanel Grid.Column="2"><Label Content="Base sheet name" /><TextBox x:Name="sheet_name_text" /></StackPanel></Grid></StackPanel></Border>
<Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Style="{StaticResource SectionHeader}" Text="View isolation template" /><CheckBox x:Name="isolate_view_check" Margin="0,0,0,12"><TextBlock Text="Apply a custom view template and permanently isolate each curtain wall" FontWeight="SemiBold" TextWrapping="Wrap" /></CheckBox><Label Content="View template name" /><TextBox x:Name="view_template_name_text" Margin="0,0,0,8" /><Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="5" Padding="10,8"><TextBlock Foreground="#475569" FontSize="11" TextWrapping="Wrap" Text="The command creates or reuses this Section view template for Architectural, Fine, Hidden Line graphics. Each generated view then permanently hides non-target model elements while retaining the host wall, panels, mullions, curtain-grid lines, inserts and nested panel components. Dimensions and notes are added afterwards." /></Border></StackPanel></Border>
<Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Style="{StaticResource SectionHeader}" Text="Curtain wall dimensions" /><CheckBox x:Name="dimension_grids_check" Margin="0,0,0,10"><TextBlock Text="Add chained dimensions to curtain grid lines" TextWrapping="Wrap" /></CheckBox><CheckBox x:Name="dimension_overall_check" Margin="0,0,0,14"><TextBlock Text="Add overall curtain wall width and height dimensions" TextWrapping="Wrap" /></CheckBox><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><Label Content="Dimension line spacing (mm)" /><TextBox x:Name="dimension_spacing_text" /></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Bottom"><TextBlock Foreground="#64748B" TextWrapping="Wrap" Text="The crop margin is enlarged automatically when dimensions need more room." /></StackPanel></Grid></StackPanel></Border>
<Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,14"><StackPanel><TextBlock Style="{StaticResource SectionHeader}" Text="Scale and layout" /><CheckBox x:Name="optimize_sheet_check" Margin="0,0,0,5"><TextBlock Text="Optimize viewport placement for the selected architectural sheet size (A0-A4)" FontWeight="SemiBold" TextWrapping="Wrap" /></CheckBox><TextBlock Margin="21,0,0,14" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Text="Uses the measured sheet width, height and orientation to maximize usable space. Custom and non-A-series title blocks use the standard row layout when this option is disabled." /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /><RowDefinition Height="14" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel Grid.Row="0" Grid.Column="0"><Label Content="Drawing scale" /><ComboBox x:Name="scale_combo" IsEditable="True" IsTextSearchEnabled="False" StaysOpenOnEdit="True" ToolTip="Choose a standard scale or type a custom denominator, for example 1:40." /><TextBlock Margin="1,5,0,0" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Text="Choose a standard ratio or type a custom value such as 1:40." /></StackPanel><StackPanel Grid.Row="0" Grid.Column="2"><Label Content="Crop margin (mm)" /><TextBox x:Name="crop_margin_text" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="0"><Label Content="Viewport gap (mm)" /><TextBox x:Name="viewport_gap_text" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="2"><Label Content="Sheet edge margin (mm)" /><TextBox x:Name="sheet_margin_text" /></StackPanel><StackPanel Grid.Row="4" Grid.Column="0"><Label Content="Bottom reserved area (mm)" /><TextBox x:Name="bottom_reserve_text" /></StackPanel><StackPanel Grid.Row="4" Grid.Column="2" VerticalAlignment="Bottom" Margin="0,3,0,0"><CheckBox x:Name="multiple_sheets_check" Margin="0,0,0,10"><TextBlock Text="Place overflow views on continuation sheets" TextWrapping="Wrap" /></CheckBox><CheckBox x:Name="auto_fit_check" Margin="0,0,0,10"><TextBlock Text="Auto-adjust to a smaller drawing size only when a viewport is too large" TextWrapping="Wrap" /></CheckBox><CheckBox x:Name="open_sheet_check" Content="Open the first new sheet after creation" /></StackPanel></Grid></StackPanel></Border>
<Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="14"><StackPanel><TextBlock FontWeight="Bold" Foreground="#1E3A8A" Text="Scope and dimension behaviour" /><TextBlock Margin="0,5,0,0" Foreground="#1E40AF" TextWrapping="Wrap" Text="The command processes each curtain-wall Wall instance once and creates only its front elevation. A custom Section view template standardizes the graphics, while permanent per-view isolation hides other model elements and retains the selected host, panels, mullions, curtain-grid lines, inserts and nested panel components. The cut plane is placed immediately outside the front-most geometry and clipped immediately behind the assembly. The architectural optimizer recognizes title blocks by measured A0-A4 sheet dimensions. Linked models and mass-based CurtainSystem elements are excluded." /></StackPanel></Border><TextBlock x:Name="status_text" Margin="2,12,2,0" Foreground="#B91C1C" FontWeight="SemiBold" TextWrapping="Wrap" />
</StackPanel></ScrollViewer>
<Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="20,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Grid.Column="0" Content="Restore defaults" Style="{StaticResource SecondaryButton}" Click="reset_click" /><Button Grid.Column="2" Content="Cancel" Style="{StaticResource SecondaryButton}" Click="cancel_click" /><Button x:Name="create_button" Grid.Column="4" Content="Create Front Views + Sheets" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="create_click" /></Grid></Border>
</Grid>
</Window>
